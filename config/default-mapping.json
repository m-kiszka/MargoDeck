{
  "url": "https://www.margonem.pl",
  "zoom": 1.0,
  "stickDeadzone": 0.35,
  "cursorSpeed": 14,
  "cursorAccel": 2.2,
  "leftStick": {
    "up": "w",
    "down": "s",
    "left": "a",
    "right": "d"
  },
  "dpad": {
    "up": "i",
    "down": "u",
    "left": "h",
    "right": "c"
  },
  "buttons": {
    "A": {
      "type": "click"
    },
    "B": {
      "type": "keys",
      "keys": [
        "Escape",
        "z"
      ],
      "also": [
        "closePopup"
      ]
    },
    "X": {
      "type": "keys",
      "keys": [
        "f",
        "q"
      ]
    },
    "Y": {
      "type": "key",
      "key": "r"
    },
    "LB": {
      "type": "key",
      "key": "Tab"
    },
    "LT": {
      "type": "rightclick"
    },
    "RT": {
      "type": "click"
    },
    "Start": {
      "type": "key",
      "key": "t"
    },
    "Back": {
      "type": "key",
      "key": "m"
    },
    "LS": {
      "type": "key",
      "key": "e"
    },
    "RS": {
      "type": "centerCursor"
    },
    "RB": {
      "type": "nudgeModifier"
    }
  },
  "chords": {
    "X": {
      "type": "key",
      "key": "x"
    },
    "Y": {
      "type": "key",
      "key": "v"
    },
    "LT": {
      "type": "key",
      "key": "g"
    },
    "DUp": {
      "type": "zoomIn"
    },
    "DDown": {
      "type": "zoomOut"
    },
    "DLeft": {
      "type": "key",
      "key": "b"
    },
    "DRight": {
      "type": "zoomReset"
    },
    "A": {
      "type": "focusNext"
    },
    "B": {
      "type": "focusPrev"
    }
  },
  "nudgeTiles": 1
}
