{
  "name": "margodeck",
  "productName": "MargoDeck",
  "desktopName": "MargoDeck.desktop",
  "version": "1.0.0",
  "description": "Wrapper around the Margonem web game that adds controller and Steam Deck support",
  "main": "src/main.js",
  "author": "mkiszka",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dist:linux": "electron-builder --linux AppImage tar.gz --x64",
    "dist:win": "electron-builder --win portable nsis --x64 -c.extraMetadata.description=MargoDeck"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "pl.margodeck.app",
    "files": [
      "src/**/*",
      "config/**/*",
      "assets/**/*"
    ],
    "linux": {
      "category": "Game",
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "artifactName": "MargoDeck-${version}.${ext}",
      "syncDesktopName": true,
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "portable": {
      "artifactName": "MargoDeck-${version}-portable.exe"
    },
    "nsis": {
      "artifactName": "MargoDeck-${version}-setup.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "MargoDeck"
    },
    "copyright": "Marcin Kiszka"
  }
}
